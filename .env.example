# Copy this file to `.env` and fill in your keys.
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real keys.

# --- Groq (free tier) -------------------------------------------------
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
# Verify current model IDs at https://console.groq.com/docs/models — they change.
GROQ_MODEL=openai/gpt-oss-20b
# Tool calling needs a stronger model than plain chat — see NOTES.md in project 02.
GROQ_TOOL_MODEL=openai/gpt-oss-120b

# --- Google AI Studio (free tier) -------------------------------------
# Get a key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Verify current model IDs at https://ai.google.dev/gemini-api/docs/models
GOOGLE_MODEL=gemini-2.0-flash

# --- Gateway config ---------------------------------------------------
PORT=8787
# Abort the upstream request if headers haven't arrived in this long.
CONNECT_TIMEOUT_MS=10000
# Abort if the stream goes silent this long between tokens.
IDLE_TIMEOUT_MS=20000
# Max attempts to START a stream. Never retried once bytes are on the wire.
MAX_ATTEMPTS=3

# --- Observability (project 03) ---------------------------------------
PORT_03=8789
# Tracing is OFF by default so the project runs with no Docker at all.
# To turn it on:  npm run jaeger:up --workspace=03-observability
# then set this to true and restart. UI at http://localhost:16686
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# What message content gets attached to spans: full | redacted | none
# Prompts and completions contain whatever your users typed — see NOTES.md §7.
GENAI_CAPTURE=redacted
